{
  "schemaVersion": 1,
  "id": "lunamap",
  "version": "${version}",
  "name": "Luna Map",
  "description": "Luna-Look für Xaero's Minimap und Xaero's World Map: Axo-Logo, Nacht-Theme und ein gemeinsamer Einstellungs-Screen für beide Karten.",
  "authors": ["Luna-OS"],
  "contact": {
    "sources": "https://github.com/Luna-OS/luna-map-mod",
    "issues": "https://github.com/Luna-OS/luna-map-mod/issues"
  },
  "license": "MIT",
  "icon": "assets/lunamap/icon.png",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["luna.map.LunaPreLaunch"],
    "client": ["luna.map.LunaMap"],
    "modmenu": ["luna.map.LunaMapModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-resource-loader-v1": "*",
    "xaerominimap": ">=26.6.0",
    "xaeroworldmap": ">=1.47.0"
  },
  "suggests": {
    "modmenu": "*",
    "iris": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "lunamap.link.minimap": "https://modrinth.com/mod/xaeros-minimap",
        "lunamap.link.worldmap": "https://modrinth.com/mod/xaeros-world-map"
      }
    }
  }
}
